# Template. Copy to .env and fill in real values.
#
# GITHUB_TOKEN    fine-grained PAT, read-only on Actions, Contents,
#                 and Pull requests, scoped to the watched repository
# WEBHOOK_SECRET  random string, must match the Secret field configured
#                 in the repository's webhook settings

GITHUB_TOKEN=
WEBHOOK_SECRET=

# GROQ_API_KEY  Groq key from console.groq.com, used for diagnosis
GROQ_API_KEY=

# DATABASE_URL  Postgres connection string. Only needed when running
#               WITHOUT Docker - docker-compose.yml sets its own value
#               (host "postgres", the service name) which overrides this.
#               Leave blank to use the default, which is this same value.
DATABASE_URL=postgresql+psycopg://builddoctor:builddoctor@localhost:5433/builddoctor
