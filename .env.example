# Template. Copy to .env and fill in real values.
#
# Since Phase 11 there is no personal access token. BuildDoctor authenticates
# as a GitHub App: it signs a JWT with its private key, trades that for an
# installation access token scoped to one installation, and that token
# expires in an hour on its own. See app_auth.py.
#
# WEBHOOK_SECRET  random string, must match the Webhook secret field in the
#                 GitHub App's settings. The App and the old manual webhook
#                 deliberately share one secret, so there is one signature
#                 path to verify rather than two.

WEBHOOK_SECRET=

# --- GitHub App identity -------------------------------------------------
#
# The first three are NOT secrets - they are public identifiers visible to
# anyone who can see the App. Find them at
# Settings -> Developer settings -> GitHub Apps -> <your app>.
#
# GITHUB_APP_ID         numeric "App ID"
# GITHUB_APP_CLIENT_ID  the "Client ID", starting Iv23. Preferred over the
#                       App ID as the JWT issuer - GitHub's docs now say
#                       "Use of the client ID is recommended".
# GITHUB_APP_SLUG       the name in the App's URL, github.com/apps/<slug>.
#                       Used for the install link on the landing page.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=

# GITHUB_APP_PRIVATE_KEY_B64  THE ONE SECRET HERE. The App's .pem private
#     key, base64-encoded onto a single line. Base64 rather than raw PEM
#     because a PEM is multi-line and environment variables - especially in
#     a hosting dashboard's one-line input box - are not.
#
#     Encode the downloaded .pem WITHOUT ever printing it. This writes the
#     single-line form to key.b64, which you then move into the variable and
#     delete along with the .pem:
#
#         python -c "import base64,pathlib,sys;pathlib.Path('key.b64').write_text(base64.b64encode(pathlib.Path(sys.argv[1]).read_bytes()).decode())" your-app.private-key.pem
#
#     Note it writes to a FILE rather than stdout, deliberately. Echoing a
#     key to a terminal puts it in the scrollback and in any transcript of
#     that session, which is exactly how the Phase 10 leak happened.
#
#     Anyone holding this key can mint tokens for every installation of the
#     App. It must never be committed - *.pem and .env are both gitignored -
#     and never pasted into a chat, a terminal that logs, or an issue.

GITHUB_APP_PRIVATE_KEY_B64=

# ALLOWED_ACCOUNTS  comma-separated GitHub logins allowed to use BuildDoctor.
#     This SEEDS is_allowed when an installation is first recorded; the
#     database column is what the gate actually reads afterwards, so access
#     can be granted or revoked without a redeploy. See the Installation
#     model in db.py.
#
#     Empty means nobody. There is no wildcard, on purpose: an unset or
#     misspelled value must fail closed.

ALLOWED_ACCOUNTS=

# GROQ_API_KEY  Groq key from console.groq.com, used for diagnosis
GROQ_API_KEY=

# DATABASE_URL  Postgres connection string. Only needed when running
#               WITHOUT Docker - docker-compose.yml sets its own value
#               (host "postgres", the service name) which overrides this.
#               Leave blank to use the default, which is this same value.
DATABASE_URL=postgresql+psycopg://builddoctor:builddoctor@localhost:5433/builddoctor

# MCP_SERVER_URL  Where the four GitHub action tools are served. Only
#                 needed when running the app WITHOUT Docker -
#                 docker-compose.yml sets http://mcp:8001/mcp (the
#                 service name), which overrides this.
MCP_SERVER_URL=http://localhost:8001/mcp

# MCP_ALLOWED_HOSTS  Host header allowlist for the MCP server's
#                    DNS-rebinding protection. Defaults to
#                    mcp:8001,localhost:8001,127.0.0.1:8001
MCP_ALLOWED_HOSTS=
