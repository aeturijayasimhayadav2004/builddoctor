# Template. Copy to .env and fill in real values.
#
# Since Phase 11 there is no personal access token. BuildDoctor authenticates
# as a GitHub App: it signs a JWT with its private key, trades that for an
# installation access token scoped to one installation, and that token
# expires in an hour on its own. See app_auth.py.
#
# WEBHOOK_SECRET  random string, must match the Webhook secret field in the
#                 GitHub App's settings. The App and the old manual webhook
#                 deliberately share one secret, so there is one signature
#                 path to verify rather than two.

WEBHOOK_SECRET=

# --- GitHub App identity -------------------------------------------------
#
# The first three are NOT secrets - they are public identifiers visible to
# anyone who can see the App. Find them at
# Settings -> Developer settings -> GitHub Apps -> <your app>.
#
# GITHUB_APP_ID         numeric "App ID"
# GITHUB_APP_CLIENT_ID  the "Client ID", starting Iv23. Preferred over the
#                       App ID as the JWT issuer - GitHub's docs now say
#                       "Use of the client ID is recommended".
# GITHUB_APP_SLUG       the name in the App's URL, github.com/apps/<slug>.
#                       Used for the install link on the landing page.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=

# --- Dashboard sign-in (Phase 12) ----------------------------------------
#
# People sign into the dashboard with the SAME GitHub App, using its
# user-to-server flow. There is no separate OAuth App and no password
# anywhere in this system.
#
# GITHUB_APP_CLIENT_SECRET  A SECRET. Generate it under "Client secrets" on
#     the App's General settings page; GitHub shows it exactly once. It pairs
#     with the public client ID above to trade an authorization code for a
#     user access token.
#
#     Keep it straight from the private key: the private key says "I am the
#     App" and mints installation tokens that can write to repositories.
#     This one only participates in sign-in. Both are secrets; only one of
#     them can post a comment.

GITHUB_APP_CLIENT_SECRET=

# SESSION_SECRET  A SECRET, but a local one - nothing outside this service
#     has ever seen it. It signs the dashboard's session cookie.
#
#     Anyone holding it can forge a session for any GitHub login, including
#     one with more installations than their own, so it is exactly as
#     sensitive as the GitHub credentials even though it comes from nowhere.
#     Changing it invalidates every session, which is the emergency
#     sign-everybody-out lever.
#
#     Generate one without displaying it:
#
#         python -c "import secrets,pathlib;pathlib.Path('session.key').write_text(secrets.token_hex(32))"
#
#     Unset means sign-in is disabled and the app says so at startup, rather
#     than falling back to a random key that would silently log everyone out
#     on every restart.

SESSION_SECRET=

# PUBLIC_BASE_URL  Where this service is reachable FROM A BROWSER, with no
#     trailing slash. The OAuth redirect_uri is built from it, and it must
#     match the Callback URL in the App's settings byte for byte - wildcard
#     matching is deliberately off, so a stray slash is a hard error from
#     GitHub rather than a silent fallback.
#
#     An environment variable rather than something read off the request's
#     Host header on purpose: the Host header is attacker-controlled, and
#     deriving the redirect from it would let a forged request send the
#     authorization code somewhere else.
#
#     Defaults to http://localhost:8000, which is right for local
#     development. Production sets https://builddoctor.onrender.com.

PUBLIC_BASE_URL=

# GITHUB_APP_PRIVATE_KEY_B64  THE ONE SECRET HERE. The App's .pem private
#     key, base64-encoded onto a single line. Base64 rather than raw PEM
#     because a PEM is multi-line and environment variables - especially in
#     a hosting dashboard's one-line input box - are not.
#
#     Encode the downloaded .pem WITHOUT ever printing it. This writes the
#     single-line form to key.b64, which you then move into the variable and
#     delete along with the .pem:
#
#         python -c "import base64,pathlib,sys;pathlib.Path('key.b64').write_text(base64.b64encode(pathlib.Path(sys.argv[1]).read_bytes()).decode())" your-app.private-key.pem
#
#     Note it writes to a FILE rather than stdout, deliberately. Echoing a
#     key to a terminal puts it in the scrollback and in any transcript of
#     that session, which is exactly how the Phase 10 leak happened.
#
#     Anyone holding this key can mint tokens for every installation of the
#     App. It must never be committed - *.pem and .env are both gitignored -
#     and never pasted into a chat, a terminal that logs, or an issue.

GITHUB_APP_PRIVATE_KEY_B64=

# ALLOWED_ACCOUNTS was REMOVED in Phase 13. If you have it in a .env from
#     an earlier phase, delete the line - nothing reads it any more.
#
#     It used to seed installations.is_allowed when a row was first created,
#     so a listed account arrived pre-approved. Approval is now a decision a
#     person makes in the dashboard's admin view, which writes the same
#     column directly. Every new installation lands closed, with no exception
#     for anybody, and there is no configuration that changes that.
#
#     There is deliberately no ADMIN_ACCOUNTS replacement either. Who may
#     approve is answered by GET /app - the account that registered the App -
#     which cannot drift out of date the way a login copied into two config
#     files can. See admin.py.

# GROQ_API_KEY  Groq key from console.groq.com, used for diagnosis
GROQ_API_KEY=

# DATABASE_URL  Postgres connection string. Only needed when running
#               WITHOUT Docker - docker-compose.yml sets its own value
#               (host "postgres", the service name) which overrides this.
#               Leave blank to use the default, which is this same value.
DATABASE_URL=postgresql+psycopg://builddoctor:builddoctor@localhost:5433/builddoctor

# MCP_SERVER_URL  Where the four GitHub action tools are served. Only
#                 needed when running the app WITHOUT Docker -
#                 docker-compose.yml sets http://mcp:8001/mcp (the
#                 service name), which overrides this.
MCP_SERVER_URL=http://localhost:8001/mcp

# MCP_ALLOWED_HOSTS  Host header allowlist for the MCP server's
#                    DNS-rebinding protection. Defaults to
#                    mcp:8001,localhost:8001,127.0.0.1:8001
MCP_ALLOWED_HOSTS=
