# Windows virtualenv - wrong platform's binaries, and large.
.venv/

# Rebuilt inside the image anyway.
__pycache__/
*.pyc

# Secrets must NEVER be baked into an image layer. Image layers are
# permanent and shippable, exactly like git history. Secrets are injected
# at runtime instead, via env_file in docker-compose.yml.
.env

# Runtime data, not source.
logs/
diagnoses.jsonl

# Not needed to run the app.
.git/
.gitignore
README.md

# The dashboard has its own image (frontend/Dockerfile) and its own build
# context. Without this line the app image would swallow the frontend's
# node_modules - tens of megabytes of Windows-built JavaScript that the
# Python container has no use for.
frontend/
