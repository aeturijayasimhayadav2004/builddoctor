# Windows virtualenv - wrong platform's binaries, and large.
.venv/

# Rebuilt inside the image anyway.
__pycache__/
*.pyc

# Secrets must NEVER be baked into an image layer. Image layers are
# permanent and shippable, exactly like git history. Secrets are injected
# at runtime instead, via env_file in docker-compose.yml.
.env

# Runtime data, not source.
logs/
diagnoses.jsonl

# Not needed to run the app.
.git/
.gitignore
README.md

# The frontend SOURCE is now part of this build context (Phase 12): the app
# image builds the dashboard bundle in a node stage and serves it itself, so
# that the session cookie and the API share one origin.
#
# These two are still excluded, for the original reason. node_modules here is
# tens of megabytes of Windows-built JavaScript that a Linux image cannot use,
# and dist is whatever was last built on the host - copying either in would
# make the image depend on the state of somebody's laptop.
frontend/node_modules/
frontend/dist/
