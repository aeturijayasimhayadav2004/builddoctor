# Virtual environment - rebuild it with: pip install -r requirements.txt
.venv/

# Python bytecode - regenerated automatically
__pycache__/
*.pyc

# Secrets: GitHub token and webhook secret. Never commit this.
.env

# CI logs downloaded from GitHub at runtime
logs/

# Recorded diagnoses: contains log excerpts and model output from the
# watched repository. Runtime data, not source. Replaced by Postgres in
# Phase 3 but kept until the migration has been run.
diagnoses.jsonl

# Raw eval results. eval/report.md is the committed artifact; this is the
# machine-readable form of the same run, rewritten every time run_eval.py
# is invoked, so committing it would be pure churn.
eval/last_run.json
.neon

# Agent skills vendored by `npx skills add` (Neon CLI/Postgres helpers).
# Reinstallable from skills-lock.json, which IS committed - same rule as
# node_modules versus package-lock.json. .claude/skills holds symlinks into
# .agents, which do not survive a checkout on Windows anyway.
.agents/
.claude/

# GitHub App private key (Phase 11). The .pem must never be committed - it
# is the App's whole identity, and anyone holding it can mint installation
# tokens for every repo the App is installed on. It is stored base64-encoded
# in GITHUB_APP_PRIVATE_KEY_B64 instead, so no .pem should exist here at all.
# This line is defence in depth for the moment one is downloaded by mistake.
*.pem
